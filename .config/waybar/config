{
	"layer": "top",
	"height": 32,
	"modules-left": [
		"niri/workspaces",
		"niri/window"
	],
	"modules-center": [
		"clock",
		"wireplumber",
		"idle_inhibitor",
		"privacy"
	],
	"modules-right": [
		"disk",
		"network",
		"cpu",
		"memory",
		"tray"
	],
	"clock": {
		"format": "{:%a %d %b %H:%M}",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format-alt": "{:%Y-%m-%d}"
	},
	"network": {
		"format-wifi": "{essid}",
		"format-ethernet": "ETH-IP: {ipaddr}",
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "󰤮 Disconnected",
		"format-alt": "{ifname}: {ipaddr}/{cidr}"
	},
	"tray": {
		"icon-size": 13,
		"spacing": 5
	},
	"disk": {
		"interval": 30,
		"format": "/home/tjh {percentage_free}% FREE",
		"path": "/home/tjh"
	},
	"memory": {
		"interval": 2,
		"format": "RAM {used:0.1f}G/{total:0.1f}G "
	},
	"cpu": {
		"interval": 2,
		"format": "CPU {}% ",
		"max-length": 20
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "",
			"deactivated": ""
		}
	}
}